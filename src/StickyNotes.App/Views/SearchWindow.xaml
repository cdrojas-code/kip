<Window x:Class="StickyNotes.App.Views.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:StickyNotes.App.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:SearchViewModel}"
        Title="Buscar notas" Width="420" Height="480" MinWidth="300" MinHeight="250"
        Topmost="True" WindowStartupLocation="CenterScreen" Icon="/Assets/Kip.ico"
        FontFamily="Segoe UI" FontSize="13" Language="es-ES">
    <DockPanel Margin="12">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBox x:Name="QueryBox" Padding="6,4" VerticalContentAlignment="Center"
                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                     PreviewKeyDown="QueryBox_PreviewKeyDown" />
            <TextBlock Text="Buscar por título, cliente, expediente o texto…" Margin="9,0,0,0"
                       Style="{StaticResource PlaceholderText}"
                       Visibility="{Binding Query, Converter={StaticResource BoolToVisInverted}}" />
        </Grid>
        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="Gray" FontSize="11"
                   Text="Enter o doble clic para ir a la nota." />
        <Grid>
            <ListBox x:Name="ResultList" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}"
                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="ResultList_MouseDoubleClick" KeyDown="ResultList_KeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="2,4">
                            <Border DockPanel.Dock="Left" Width="14" Height="14" CornerRadius="2" Margin="0,2,8,0"
                                    VerticalAlignment="Top" BorderThickness="1"
                                    Background="{Binding Color, Converter={StaticResource NoteColorBrush}, ConverterParameter=Header}"
                                    BorderBrush="{Binding Color, Converter={StaticResource NoteColorBrush}, ConverterParameter=Border}" />
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Snippet}" Foreground="#666" FontSize="12"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="No se encontraron notas." HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="Gray" IsHitTestVisible="False"
                       Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </DockPanel>
</Window>
