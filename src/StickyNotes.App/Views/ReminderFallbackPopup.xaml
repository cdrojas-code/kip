<!-- Aviso propio cuando las notificaciones de Windows no están disponibles. -->
<Window x:Class="StickyNotes.App.Views.ReminderFallbackPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recordatorio" Width="320" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Segoe UI" FontSize="13" Language="es-ES"
        Background="{Binding Color, Converter={StaticResource NoteColorBrush}, ConverterParameter=Body}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border BorderThickness="1"
            BorderBrush="{Binding Color, Converter={StaticResource NoteColorBrush}, ConverterParameter=Border}">
        <StackPanel>
            <DockPanel Background="{Binding Color, Converter={StaticResource NoteColorBrush}, ConverterParameter=Header}">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Cerrar"
                        Click="Close_Click" />
                <TextBlock Margin="10,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Note.Foreground}">
                    <Run FontFamily="{StaticResource IconFont}" Text="&#xE823;" />
                    <Run Text=" Recordatorio" />
                </TextBlock>
            </DockPanel>
            <StackPanel Margin="12,10,12,12">
                <TextBlock x:Name="TitleText" FontWeight="Bold" TextWrapping="Wrap" Foreground="{DynamicResource Note.Foreground}" />
                <TextBlock x:Name="BodyText" Margin="0,4,0,0" TextWrapping="Wrap" MaxHeight="80"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Note.Foreground}" />
                <TextBlock x:Name="DueText" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource Note.Muted}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="Ver nota" Padding="12,3" Margin="0,0,8,0" Click="Open_Click" />
                    <Button Content="Cerrar" Padding="12,3" Click="Close_Click" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
