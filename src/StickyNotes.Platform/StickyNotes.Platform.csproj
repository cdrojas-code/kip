<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>StickyNotes.Platform</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\StickyNotes.Core\StickyNotes.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Toasts para apps Win32 sin empaquetar (ToastNotificationManagerCompat). -->
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- Permite probar ScreenShareDetector.Matches, ShareSignatures y el parser de atajos. -->
    <InternalsVisibleTo Include="StickyNotes.Platform.Tests" />
  </ItemGroup>
</Project>
